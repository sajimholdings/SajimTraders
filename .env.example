# BEEP Gateway & Sajim Holdings Environment Configuration
# Copy to .env and fill in real values. NEVER commit real keys/secrets.
BEEP_API_PORT=8080
BEEP_API_URL=http://localhost:8080

# API Keys (replace with real values)
BEEP_CLIENT_KEY=replace-me-client-key
BEEP_SAMMY_KEY=replace-me-sammy-key
BEEP_MASTER_KEY=replace-me-master-key

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=

# MT5 bridge (Windows host only)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_ACCOUNT_TYPE=
# All broker accounts in one JSON map: id -> {password, server, type}
BROKER_ACCOUNTS_JSON=

# cTrader Open API (Pure Python Cloud Bridge — Linux/Render compatible)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENVIRONMENT=demo
BROKER_BACKEND=ctrader

# Broker Affiliate
NEXT_PUBLIC_HEADWAY_AFFILIATE_URL=

