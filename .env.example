# BEEP Gateway & Sajim Holdings Environment Configuration
# Copy to .env and fill in real values. NEVER commit real keys/secrets.
BEEP_API_PORT=8080
BEEP_API_URL=http://localhost:8080

# API Keys (replace with real values)
BEEP_CLIENT_KEY=replace-me-client-key
BEEP_SAMMY_KEY=replace-me-sammy-key
BEEP_MASTER_KEY=replace-me-master-key
# Key used by core/app.py client (no built-in fallback)
BEEP_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI admin routes (X-ADMIN-KEY). Admin routes deny all requests when unset.
ADMIN_KEY=

# Dedicated key for encrypting stored MT5 passwords (REQUIRED to connect accounts).
# Must be identical on the API host and the bridge supervisor host.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDENTIAL_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=

# MT5 bridge (Windows host only)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_ACCOUNT_TYPE=
# All broker accounts in one JSON map: id -> {password, server, type}
BROKER_ACCOUNTS_JSON=

# MT5 bridge supervisor: per-account terminals (see scripts/bridge_supervisor.py)
# MT5_TERMINALS_DIR=C:\SajimTerminals
# MT5_TERMINAL_PATH_<account_id>=C:\path\to\terminal64.exe

# cTrader Open API — NOT FUNCTIONAL (core/ctrader_bridge.py is a stub; nothing reads
# BROKER_BACKEND). Left commented until the integration is implemented.
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_ACCESS_TOKEN=
# CTRADER_ACCOUNT_ID=
# CTRADER_ENVIRONMENT=demo

# Broker Affiliate
NEXT_PUBLIC_HEADWAY_AFFILIATE_URL=

