# Sajim Traders client portal — environment variables.
# Copy to .env.local for local development; set the same keys in the Vercel
# project (Settings -> Environment Variables) for Preview and Production.

# Supabase project URL and anon/publishable key (REQUIRED). Inlined into the
# client bundle at build time; sign-in is disabled with a config error if unset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend that /api/* is rewritten to (server-side, next.config.js).
# Defaults to https://sajim-traders.onrender.com when unset.
RENDER_BACKEND_URL=https://sajim-traders.onrender.com

# Headway partner signup link shown in the UI (optional; has a built-in default).
NEXT_PUBLIC_HEADWAY_AFFILIATE_URL=https://headway.partners/user/signup?hwp=b158cc
